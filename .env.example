# Massing Bill configuration.
#
# EVERY VALUE HERE IS OPTIONAL. With no .env file at all the application boots
# standalone on SQLite with local storage and no licence enforcement. This file
# exists to show what can be changed, not what must be.

# ── Core ─────────────────────────────────────────────────────────────────────
# development | testing | production
MASSINGBILL_ENV=development

# Required in production. Generate one with: massingbill gen-secret
# MASSINGBILL_SECRET_KEY=

# Also required in production, and deliberately SEPARATE from the key above.
# This one encrypts TOTP seeds and integration tokens at rest, so rotating the
# session key must not make every stored seed undecryptable and lock every user
# out of two-factor. Generate a second value with: massingbill gen-secret
# MASSINGBILL_ENCRYPTION_KEY=

# Defaults to sqlite:///instance/massingbill.sqlite3
# MASSINGBILL_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/massingbill

# MASSINGBILL_INSTANCE_PATH=instance

# ── Adapters (all optional; the defaults below need nothing external) ────────
# standalone | massing_cloud
MASSINGBILL_ENTITLEMENT_PROVIDER=standalone
# local | s3 | massing_vault
MASSINGBILL_STORAGE_BACKEND=local
# Comma-separated. Empty means local password accounts only.
MASSINGBILL_OIDC_PROVIDERS=

# ── Optional: massing.cloud (ships in P9; leave unset for a standalone install)
# MASSINGBILL_MASSING_BASE_URL=https://massing.cloud
# MASSINGBILL_MASSING_SHARED_SECRET=
# MASSINGBILL_MASSING_LICENSE_KEY=
# The mcds_ key used for entitlements and vault storage. Needs
# massingbill[massing]; without the extra the adapters are simply absent.
# MASSINGBILL_MASSING_API_KEY=

# ── Optional: S3-compatible storage (ships in P7) ────────────────────────────
# MASSINGBILL_S3_BUCKET=
# MASSINGBILL_S3_REGION=
# MASSINGBILL_S3_ENDPOINT_URL=
# MASSINGBILL_S3_ACCESS_KEY_ID=
# MASSINGBILL_S3_SECRET_ACCESS_KEY=

# ── API and webhooks ─────────────────────────────────────────────────────────
# Per-key ceiling, unless a key sets its own.
# MASSINGBILL_API_RATE_LIMIT_DEFAULT=600 per minute
# MASSINGBILL_WEBHOOK_MAX_ATTEMPTS=6
# MASSINGBILL_WEBHOOK_DISABLE_AFTER_FAILURES=20
# MASSINGBILL_WEBHOOK_TIMEOUT_SECONDS=10
#
# Whether a webhook may target a private, loopback or link-local address.
# TRUE by default because self-hosting is the product: an ERP on 10.0.0.0/8 is
# the normal case, not an attack. Set this to false on any MULTI-TENANT
# deployment, where one tenant could otherwise aim a webhook at the cloud
# metadata endpoint and read the host's credentials.
# MASSINGBILL_WEBHOOK_ALLOW_PRIVATE_TARGETS=true

# ── Web ──────────────────────────────────────────────────────────────────────
# MASSINGBILL_SESSION_COOKIE_SECURE=true
# MASSINGBILL_RATE_LIMIT_DEFAULT=240 per hour

# ── Observability ────────────────────────────────────────────────────────────
# MASSINGBILL_LOG_LEVEL=INFO
# MASSINGBILL_LOG_JSON=true
